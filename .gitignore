# ---- 本机私有，绝不入库 ----
tools/.bridge-key
tools/bridge.log
tools/bridge.req.log
tools/layout.json
# frp（自建 VPS 隧道）：frpc.toml 里有 frps 的 token，等同钥匙
tools/.frp-token
tools/frp/
tools/frpc.log
tools/frpc.err.log

# ---- 体积大 / 可重新生成 ----
# android/android-sdk/ ：bootstrap-sdk.ps1 可重建，231 MB
android/android-sdk/
# android/dl/ ：下载的 build-tools / platform 压缩包，116 MB
android/dl/
android/build/
tmp/
# .tmp/ ：仓库根下的一次性临时产物（离线页预览、快照样本、临时探针脚本）
.tmp/
# /build/ ：仓库根下的 javac 产物（test\*.java 手编时的 -d 目标）
/build/

# ---- Gradle 构建（工具链可重下，产物可重建）----
# android/tools/ ：JDK 17 + Gradle 8.9 解包，约 700 MB
android/tools/
android/local.properties
android/.gradle/
android/.gradle-home/
android/.tmp/
android/.android-home/
android/app/build/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini