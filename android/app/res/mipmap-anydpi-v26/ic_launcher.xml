<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). minSdk is 26, so this is what devices actually use; the
     mipmap-*/ic_launcher.png files from make-icon.py are the fallback. @color/ic_bg matches the
     art's own background, so its rounded corners disappear against the canvas. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_bg" />
    <foreground android:drawable="@mipmap/ic_fg" />
</adaptive-icon>
