<!-- WebActivity is a plain android.app.Activity, so its menu uses the platform namespace - the
     appcompat namespace (app:showAsAction) would be ignored here. "never" is the default for an
     item without an icon, so it is left out on purpose (lint AppCompatResource). -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/action_setup"
        android:title="@string/action_setup" />
    <item
        android:id="@+id/action_reload"
        android:title="@string/action_reload" />
    <item
        android:id="@+id/action_native"
        android:title="@string/action_native" />
</menu>