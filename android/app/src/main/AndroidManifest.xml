<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <!-- Native screens: sessions list and one chat. Material theme with no action bar, because
             the layout carries its own Toolbar. -->
        <activity
            android:name="app.dsh.remote.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/NativeTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.dsh.remote.ChatActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/NativeTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- Fallback: the plain framework WebView shell, on the platform theme it was built for. -->
        <activity
            android:name="app.dsh.remote.WebActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
