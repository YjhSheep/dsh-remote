<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode/versionName live in app/build.gradle.kts only. A copy here is a second place to keep
     in sync and it silently went stale; aapt2 link gets its numbers from Gradle, and
     android/gradle-build.ps1 is the only build left, so nothing reads these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <!-- The activities carry no label of their own: they inherit @string/app_name, so a copy
             here would only be a second place to keep in sync. -->

        <!-- One activity, and that is the whole app: a WebView around the DSH web UI (with the
             bridge's mobile.css injected), reached through the loopback tunnel. The native
             list/chat screens are gone - they were a second, worse copy of UI that DSH already
             ships - so there is no AppCompat/Material activity left and no library beyond androidx
             core. -->
        <activity
            android:name="app.dsh.remote.WebActivity"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>